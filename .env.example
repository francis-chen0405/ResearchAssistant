# Optional test gate. Normal Phase 8 tests remain deterministic and offline.
RUN_LLM_INTEGRATION_TESTS=
# MVP-3B direct Xiaomi MiMo configuration. Never commit a real key.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
WIGOLO_BASE_URL=http://127.0.0.1:8000
# Exa is required for discovery in new live runs. Firecrawl is an optional acquisition fallback.
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# Optional MVP-4 live CLI smoke. Both exact gates are required; credentials alone do nothing.
RUN_MVP4_LIVE_CLI_SMOKE=
MVP4_LIVE_CLI_APPROVED=
# Live boundary/canary execution remains disabled unless every explicit gate is supplied.
# Legacy MVP-2B boundary smoke only. Keep blank until an explicitly approved execution.
OPENROUTER_API_KEY=
RESEARCH_ASSISTANT_LIVE_SMOKE=
RESEARCH_ASSISTANT_LIVE_APPROVED=
RESEARCH_ASSISTANT_SMOKE_MAX_SEARCH_CALLS=1
RESEARCH_ASSISTANT_SMOKE_MAX_ACQUISITION_CALLS=1
RESEARCH_ASSISTANT_SMOKE_MAX_LLM_CALLS=1
RESEARCH_ASSISTANT_SMOKE_MAX_TOKENS=25000
RESEARCH_ASSISTANT_SMOKE_MAX_COST_USD=0.05
RESEARCH_ASSISTANT_SMOKE_OUTPUT=/tmp/researchassistant-smoke-output.json
