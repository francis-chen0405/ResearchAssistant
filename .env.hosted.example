# Staging only. Keep private values in Render/Supabase secret management.
RA_DEPLOYMENT_ENV=staging

# Public browser configuration: safe for the Next.js client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private API and worker configuration: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
HOSTED_JOB_LEASE_SECONDS=300
HOSTED_PIPELINE_EXECUTOR=canonical
# Deployment-owned adapter around the canonical v2 coordinator.
HOSTED_CANONICAL_RUNNER=hosted_canonical:run_canonical_hosted_pipeline

# Next server-side proxy target. Render supplies this from the private API hostport.
HOSTED_API_HOSTPORT=
