{
  "name": "researchassistant-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local ResearchAssistant desktop application",
  "author": "ResearchAssistant contributors",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.researchassistant.desktop",
    "productName": "ResearchAssistant",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "package.json"],
    "extraResources": [{ "from": "build/resources", "to": "." }],
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.productivity" },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false }
  }
}
